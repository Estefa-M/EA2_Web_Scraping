<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Observatorio de precios · Calzatodo</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --tinta: #1b2430;
      --gris: #5b6776;
      --linea: #e3e8ef;
      --fondo: #f5f7fa;
      --azul: #1d4ed8;
      --verde: #0f7b57;
      --ambar: #b45309;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--fondo);
      color: var(--tinta);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      line-height: 1.5;
    }
    .contenedor { max-width: 1120px; margin: 0 auto; padding: 28px 20px 48px; }
    header.portada {
      background: linear-gradient(135deg, #10233f, #1d4ed8);
      color: #fff;
      border-radius: 18px;
      padding: 28px 30px;
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 10px 28px rgba(16, 35, 63, .18);
    }
    header.portada h1 { margin: 0 0 6px; font-size: 1.65rem; }
    header.portada p { margin: 0; opacity: .85; font-size: .95rem; }
    .sello {
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.25);
      border-radius: 999px;
      padding: 8px 16px;
      font-size: .82rem;
      white-space: nowrap;
    }
    .rejilla { display: grid; gap: 16px; margin-top: 20px; }
    .rejilla > * { min-width: 0; }
    .kpis { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
    .tarjeta {
      background: #fff;
      border: 1px solid var(--linea);
      border-radius: 14px;
      padding: 18px 20px;
    }
    .tarjeta .rotulo {
      margin: 0 0 6px;
      color: var(--gris);
      font-size: .76rem;
      letter-spacing: .04em;
      text-transform: uppercase;
      font-weight: 700;
    }
    .tarjeta .valor { margin: 0; font-size: 1.75rem; font-weight: 800; }
    .tarjeta .nota { margin: 4px 0 0; color: var(--gris); font-size: .8rem; }
    .graficas { grid-template-columns: 1.4fr 1fr; }
    @media (max-width: 820px) { .graficas { grid-template-columns: 1fr; } }
    .graficas .tarjeta h2, .tabla-card h2 {
      margin: 0 0 14px;
      font-size: 1rem;
      letter-spacing: .01em;
    }
    .lienzo { position: relative; height: 280px; width: 100%; }
    .lienzo canvas { max-width: 100% !important; }
    .tabla-card { margin-top: 20px; }
    .barra {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .barra input {
      width: min(360px, 100%);
      padding: 10px 14px;
      border: 1px solid var(--linea);
      border-radius: 10px;
      font-size: .92rem;
    }
    .barra input:focus { outline: 2px solid #bfdbfe; border-color: var(--azul); }
    .tabla-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    thead th {
      text-align: left;
      font-size: .74rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      color: var(--gris);
      border-bottom: 2px solid var(--linea);
      padding: 10px 12px;
    }
    tbody td { padding: 11px 12px; border-bottom: 1px solid var(--linea); vertical-align: top; }
    tbody tr:hover { background: #f8fafc; }
    .sku {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: .8rem;
      background: #eef2f7;
      border-radius: 6px;
      padding: 2px 7px;
      color: #344055;
    }
    .precio { font-weight: 700; white-space: nowrap; }
    .chip {
      display: inline-block;
      font-size: .74rem;
      font-weight: 700;
      border-radius: 999px;
      padding: 3px 10px;
    }
    .chip.disponible { background: #e7f6ef; color: var(--verde); }
    .chip.agotado { background: #fdecea; color: #b42318; }
    .chip.otro { background: #fef3c7; color: var(--ambar); }
    a { color: var(--azul); }
    footer {
      margin-top: 26px;
      color: var(--gris);
      font-size: .82rem;
      border-top: 1px solid var(--linea);
      padding-top: 16px;
    }
    footer p { margin: 4px 0; }
    .vacio { color: var(--gris); padding: 18px 0; text-align: center; }
  </style>
</head>
<body>
  <div class="contenedor">
    <header class="portada">
      <div>
        <h1>Observatorio de precios · Calzatodo</h1>
        <p>Tenis deportivos para mujer · datos extraídos del catálogo público</p>
      </div>
      <div class="sello">Actualizado: {{ generado }} (hora Colombia)</div>
    </header>

    <section class="rejilla kpis" aria-label="Indicadores del catálogo">
      <article class="tarjeta">
        <p class="rotulo">Publicaciones</p>
        <p class="valor">{{ metricas.total_productos }}</p>
        <p class="nota">referencias únicas</p>
      </article>
      <article class="tarjeta">
        <p class="rotulo">Marcas</p>
        <p class="valor">{{ metricas.marcas_unicas }}</p>
        <p class="nota">en la muestra</p>
      </article>
      <article class="tarjeta">
        <p class="rotulo">Precio más bajo</p>
        <p class="valor">{{ metricas.precio_minimo | pesos }}</p>
        <p class="nota">de una publicación</p>
      </article>
      <article class="tarjeta">
        <p class="rotulo">Precio más alto</p>
        <p class="valor">{{ metricas.precio_maximo | pesos }}</p>
        <p class="nota">de una publicación</p>
      </article>
      <article class="tarjeta">
        <p class="rotulo">Precio promedio</p>
        <p class="valor">{{ metricas.precio_promedio | pesos }}</p>
        <p class="nota">mediana {{ metricas.precio_mediana | pesos }}</p>
      </article>
      <article class="tarjeta">
        <p class="rotulo">Completitud</p>
        <p class="valor">{{ "%.1f" | format(metricas.completitud_pct) }} %</p>
        <p class="nota">campos diligenciados</p>
      </article>
    </section>

    <section class="rejilla graficas">
      <article class="tarjeta">
        <h2>Publicaciones por marca</h2>
        <div class="lienzo"><canvas id="graficaMarcas" aria-label="Publicaciones por marca"></canvas></div>
      </article>
      <article class="tarjeta">
        <h2>Distribución por rango de precio</h2>
        <div class="lienzo"><canvas id="graficaRangos" aria-label="Distribución por rango de precio"></canvas></div>
      </article>
    </section>

    <section class="tarjeta tabla-card">
      <div class="barra">
        <h2>Explorador de publicaciones</h2>
        <input id="buscador" type="search" placeholder="Buscar por producto, marca o referencia…" aria-label="Buscar publicaciones">
      </div>
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr>
              <th>Producto</th>
              <th>Marca</th>
              <th>Referencia</th>
              <th>Precio</th>
              <th>Estado</th>
              <th>Enlace</th>
            </tr>
          </thead>
          <tbody id="cuerpo">
            {% for producto in productos %}
            <tr data-busqueda="{{ (producto.nombre ~ ' ' ~ producto.marca ~ ' ' ~ producto.sku) | lower }}">
              <td>{{ producto.nombre }}</td>
              <td>{{ producto.marca }}</td>
              <td><span class="sku">{{ producto.sku }}</span></td>
              <td class="precio">{{ producto.precio }}</td>
              <td>
                {% if producto.disponible == "Disponible" %}
                <span class="chip disponible">Disponible</span>
                {% elif producto.disponible == "Agotado" %}
                <span class="chip agotado">Agotado</span>
                {% else %}
                <span class="chip otro">{{ producto.disponible }}</span>
                {% endif %}
              </td>
              <td><a href="{{ producto.url }}" target="_blank" rel="noopener">Ver producto</a></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        <p id="sinResultados" class="vacio" hidden>No hay publicaciones que coincidan con la búsqueda.</p>
      </div>
    </section>

    <footer>
      <p><strong>Fuente:</strong> <a href="{{ fuente }}" target="_blank" rel="noopener">categoría de tenis deportivos para mujer de Calzatodo</a>.</p>
      <p><strong>Cómo se actualiza:</strong> un workflow de GitHub Actions ejecuta la extracción y vuelve a generar este tablero cada miércoles; el repositorio guarda el histórico de commits con los datos y las métricas. Ventana de automatización del curso: hasta el {{ vigencia }}.</p>
      <p><strong>Código y documentación:</strong> <a href="{{ repo_url }}" target="_blank" rel="noopener">{{ repo_url }}</a></p>
    </footer>
  </div>

  <script>
    const marcas = {{ metricas.top_marcas | tojson }};
    const rangos = {{ metricas.rangos_precio | tojson }};

    new Chart(document.getElementById("graficaMarcas"), {
      type: "bar",
      data: {
        labels: marcas.map(m => m.marca),
        datasets: [{
          data: marcas.map(m => m.cantidad),
          backgroundColor: "#1d4ed8",
          borderRadius: 8,
          maxBarThickness: 46
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: "#eef2f7" } },
          x: { grid: { display: false } }
        }
      }
    });

    new Chart(document.getElementById("graficaRangos"), {
      type: "doughnut",
      data: {
        labels: rangos.map(r => r.rango),
        datasets: [{
          data: rangos.map(r => r.cantidad),
          backgroundColor: ["#0f7b57", "#1d4ed8", "#f59e0b", "#b42318"],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "58%",
        plugins: { legend: { position: "bottom", labels: { boxWidth: 12, padding: 14 } } }
      }
    });

    const buscador = document.getElementById("buscador");
    const filas = Array.from(document.querySelectorAll("#cuerpo tr"));
    const aviso = document.getElementById("sinResultados");

    buscador.addEventListener("input", () => {
      const termino = buscador.value.trim().toLowerCase();
      let visibles = 0;
      filas.forEach(fila => {
        const coincide = fila.dataset.busqueda.includes(termino);
        fila.hidden = !coincide;
        if (coincide) visibles += 1;
      });
      aviso.hidden = visibles > 0;
    });
  </script>
</body>
</html>
