# Copia este archivo como .env para trabajar en local.
# En GitHub Actions estos valores se definen en el workflow o en
# Settings > Secrets and variables > Actions. Ninguno es obligatorio:
# el código trae los mismos valores por defecto.

# Categoría que se extrae
EA3_BASE_URL=https://www.calzatodo.com.co/es/mujeres/tenis/deportivo

# Cuántas páginas se recorren y cuánto se espera entre peticiones
EA3_PAGES=2
EA3_DELAY_SEG=2.0
EA3_TIMEOUT_SEG=30
EA3_REINTENTOS=3

# Último día de la ejecución programada (ventana del curso)
EA3_VIGENCIA_HASTA=2026-12-09

# Enlace que se muestra en el tablero
EA3_REPO_URL=https://github.com/Estefa-M/EA2_Web_Scraping
